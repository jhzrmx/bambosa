flowchart TB
    Member(["Member"])
    Officer(["Officer"])
    Admin(["Admin"])
    SMTP(["SMTP Email Server"])
    OSM(["OpenStreetMap / Map Tiles"])
    IPAPI(["ip-api.com<br/>IP Geolocation"])

    System["0.0<br/>BAMBOSA<br/>Irrigation Management System"]

    Member -- "signup info, login credentials,<br/>farm lot polygon, reservation requests,<br/>profile/password updates" --> System
    System -- "dashboard data, farm lot &amp; billing records,<br/>machinery/schedule status, calendar events,<br/>login/reset results,<br/>own login activity" --> Member

    Officer -- "login credentials, member approvals,<br/>sector/schedule/machinery data,<br/>billing periods, payment records,<br/>member export requests" --> System
    System -- "member lists, farm &amp; sector maps,<br/>billing reports, reservation queue,<br/>calendar events, member export files<br/>(XLSX / CSV), own login activity" --> Officer

    Admin -- "login credentials, add/edit/delete<br/>officer, member &amp; admin accounts,<br/>role/status changes, own profile updates,<br/>login log searches,<br/>failed-login monitoring" --> System
    System -- "account lists, login logs (successful &amp; failed),<br/>own login activity, validation &amp;<br/>safety-rule messages (e.g. last admin)" --> Admin

    System -- "reset link / activation notice" --> SMTP
    SMTP -- "delivery result" --> System

    System -- "IP address to look up<br/>(admin only)" --> IPAPI
    IPAPI -- "location, ISP &amp; network info" --> System

    System -- "map tile requests" --> OSM
    OSM -- "map tiles" --> System
